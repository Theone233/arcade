{
  // 平台：界面是静态资源；/api/* 先进 Worker（worker/index.ts）。正式环境只有这一个平台 Worker，没有测试 Worker（所有者 2026-10-14 定）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcade",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // 不开 workers.dev 地址：它不经过网关限速（docs/platform-backend.md 5.4）。各游戏在同一域名下用路径路由挂自己的 Worker，不经过平台。
  "workers_dev": false,
  // 也不要版本预览地址：同样绕过网关，还会连正式 D1
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /games/* 正常由游戏自己的路由接走；落到平台说明没有这个游戏，由 Worker 回 404，免得单页回退给出平台首页
    "run_worker_first": ["/api/*", "/games/*"]
  },
  "routes": [{ "pattern": "game.yyyu.org", "custom_domain": true }],
  // 账号、存档、好友等数据（库建在 apac）。database_id 不是凭证。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcade",
      "database_id": "2897c944-53e5-4da3-9797-dc0a10741136",
      "migrations_dir": "migrations"
    }
  ],
  // 每天清理过期会话、限流计数、旧计量行和 1 年未登录的账号（UTC 19:17，北京时间凌晨 3 点多，避开整点）。
  "triggers": { "crons": ["17 19 * * *"] },
  // LIMITS：要调的熔断阈值、限流上限写在这里，覆盖 worker/api/config.ts 里的默认值（docs/platform-backend.md 6.6、15.6）。
  // 紧急开关 API_MODE 是 Secret，不放这里（6.6）。
  // Secret：PEPPER_PW、PEPPER_RC、PEPPER_SID、PEPPER_IP（值写成 "<kid>:<随机串>"），换 pepper 时另设对应的 *_PREV；
  // ADMIN_TOKEN（同样格式）给主线本机的建号工具 tools/admin.ts 用。
  // REGISTRATION：注册的紧急总闸。"switch" = 听管理员在 /admin 或 npm run admin -- registration 里的开关（D1，没设过按关）；
  // 改成 "off"（或任何别的值）= 一定关，开关暂时不起作用。改这里要重新部署，平时开关注册用管理页就行（0.8.0）。
  "vars": {
    "SITE_ORIGIN": "https://game.yyyu.org",
    "REGISTRATION": "switch",
    "LIMITS": {}
  },
  // 不往 Cloudflare 存日志（Workers Logs）：现在线上就是关的。要查问题用 wrangler tail 实时看，它会把 cookie、authorization 头打成 REDACTED（2026-10-14 实测）。
  "observability": { "enabled": false }
}
