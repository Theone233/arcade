{
  // 本地工具（冒烟脚本）：在 Node 里跑，page.evaluate 里的代码在浏览器里跑，所以两边的类型都要
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // Node 直接跑 .ts，import 本模块的 src/games.ts 要写后缀
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
