// danli Worker 的独立配置（docs/new-game.md 第 4、7 节）：原样部署就是一个不要平台、谁打开都能玩的弹里个弹
// （npm run deploy 得到 danli.<子域>.workers.dev，打开 / 会转到 /games/danli/）。
// 本站正式部署时，维护者的部署工具按 tools/workers.json 在上面补平台绑定、GATE、路由和 SITE_ORIGIN，并关掉 workers_dev；
// 所以这里不写 services 和 GATE。M1 只有单机，没有好友房，所以没有 Durable Object。
{
  "name": "danli",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 只有这些先过 Worker：站点根和 /api/me（单独部署时）、首页三种写法（登录闸门）；其余静态资源直接回
    "run_worker_first": ["/", "/api/me", "/games/danli", "/games/danli/", "/games/danli/index.html"]
  }
}
