{
  // 开盘：纯静态资源 Worker，只经平台的域名访问：
  // game.yyyu.org/games/kaipan* 用路径路由直接挂到这里（路由优先于平台的自定义域名，请求不经过平台的 Worker）；
  // 平台的 workers.dev 测试地址上由平台 Worker 通过服务绑定转发。自己不开 workers.dev 地址。
  "$schema": "node_modules/wrangler/config-schema.json",
  // 0.5.6：测试期邀请制。首页（只有 run_worker_first 列的这三个路径）先进 Worker，GATE=login 时问平台登录了没有，
  // 平台有问题一律不放行（见 src/worker/gate.ts）。其余静态资源不经过 Worker。
  // 0.6.0：/games/kaipan/api/*（实盘钱包接口，src/worker/live.ts）也先进 Worker，不看 GATE，总要认人。GATE 开着（login）；临时放开改成 off。
  "name": "kaipan",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "game.yyyu.org/games/kaipan", "zone_name": "yyyu.org" },
    { "pattern": "game.yyyu.org/games/kaipan/*", "zone_name": "yyyu.org" }
  ],
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/games/kaipan", "/games/kaipan/", "/games/kaipan/index.html", "/games/kaipan/api/*"]
  },
  "services": [
    { "binding": "ARCADE", "service": "arcade" },
    // 实盘钱包：props.game 必须是 kaipan，否则钱包所有调用都回 bad_game（docs/design-live.md 第 6 节）
    { "binding": "WALLET", "service": "arcade", "entrypoint": "WalletService", "props": { "game": "kaipan" } }
  ],
  "vars": { "GATE": "login" }
}
